# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Database & Cache
MONGO_URI=mongodb://localhost:27017/ecovision_ai
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_SECRET=ecovision_super_secret_jwt_key_2026_enterprise
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=ecovision_refresh_token_secret_key_2026
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=ecovision_cookie_signer
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Storage Readiness (AWS S3 & Cloudinary)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
AWS_S3_BUCKET=ecovision-ai-uploads
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret

# Email Notification Readiness (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test_user
SMTP_PASS=test_pass
EMAIL_FROM="no-reply@ecovision.ai"

# AI Model Integration Keys
OPENAI_API_KEY="mock-openai-key"
GEMINI_API_KEY="mock-gemini-key"
